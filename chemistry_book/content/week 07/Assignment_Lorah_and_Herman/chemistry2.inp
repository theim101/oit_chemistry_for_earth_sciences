//********* Write SI_minerals ************************* 
@Write_SI_minerals:
@SI_mineral(CaO[cr][s])
@logKreaction(CaO[cr][s], "-1 * (( (1.0 / log(10)) * ((32.7 * log(10)) - (-193910.0 / 8.3144598) * ((1 / @T()) - (1 / 298.15))) ))", 1.0, Ca+2, -2.0, H+, 1.0, H2O)
@SI_mineral(Portlandite[s])
@logKreaction(Portlandite[s], "-1 * (( (1.0 / log(10)) * ((22.81 * log(10)) - (-130107.0 / 8.3144598) * ((1 / @T()) - (1 / 298.15))) ))", 1.0, Ca+2, -2.0, H+, 2.0, H2O)
//*************************************************** 
@PHREEQC_Output:
@class: PHREEQCOutput(){
----------------------------Description of solution--------------------------------------------------
                            Cellnumber = @Node_ID()
                                    pH = @pH()
                                    pe = @pe()
                    Activity of water  = @evaluate:("10^@H2O.logact()")
                       Ionic strength  = @I()
           Total number of iterations  = @tot_nr_iter()

----------------------------Distribution of aqueous species---------------------------------------------

     Species            concentration (Mol/l)        Log Activity              Activity             log gamma   
Ca                  @Ca.diss()          
    Ca+2                  @Ca+2.con()  @Ca+2.logact()@evaluate:("10^@Ca+2.logact()")    @evaluate:("-@Ca+2.logf()") 
    Ca[OH]+               @Ca[OH]+.con()  @Ca[OH]+.logact()@evaluate:("10^@Ca[OH]+.logact()")    @evaluate:("-@Ca[OH]+.logf()") 
H                   @H.diss()           
    Ca[OH]+               @Ca[OH]+.con()  @Ca[OH]+.logact()@evaluate:("10^@Ca[OH]+.logact()")    @evaluate:("-@Ca[OH]+.logf()") 
    H+                    @H+.con()  @H+.logact()@evaluate:("10^@H+.logact()")    @evaluate:("-@H+.logf()") 
    OH-                   @OH-.con()  @OH-.logact()@evaluate:("10^@OH-.logact()")    @evaluate:("-@OH-.logf()") 
O                   @O.diss()           
    Ca[OH]+               @Ca[OH]+.con()  @Ca[OH]+.logact()@evaluate:("10^@Ca[OH]+.logact()")    @evaluate:("-@Ca[OH]+.logf()") 
    OH-                   @OH-.con()  @OH-.logact()@evaluate:("10^@OH-.logact()")    @evaluate:("-@OH-.logf()") 

----------------------------Description  of mineral phases --------------------------------------------------
     Mineral           concentration (Mol/l)           SI  
Ca                  @Ca.min()                
H                   @H.min()                 
O                   @O.min()                 

---------------------------- Description of CLAY_part phase --------------------------------------------------
Ca                       @Ca.CLAY_part()          
H                        @H.CLAY_part()           
O                        @O.CLAY_part()           

---------------------------- Description of CLAY_part_l phase --------------------------------------------------
Ca                       @Ca.CLAY_part_l()        
H                        @H.CLAY_part_l()         
O                        @O.CLAY_part_l()         

---------------------------- Description of DFA_part phase --------------------------------------------------
Ca                       @Ca.DFA_part()           
H                        @H.DFA_part()            
O                        @O.DFA_part()            

---------------------------- Description of DHA_part phase --------------------------------------------------
Ca                       @Ca.DHA_part()           
H                        @H.DHA_part()            
O                        @O.DHA_part()            

---------------------------- Description of FA_part phase --------------------------------------------------
Ca                       @Ca.FA_part()            
H                        @H.FA_part()             
O                        @O.FA_part()             

---------------------------- Description of Goethite_part phase --------------------------------------------------
Ca                       @Ca.Goethite_part()      
H                        @H.Goethite_part()       
O                        @O.Goethite_part()       

---------------------------- Description of Goethite_part_l phase --------------------------------------------------
Ca                       @Ca.Goethite_part_l()    
H                        @H.Goethite_part_l()     
O                        @O.Goethite_part_l()     

---------------------------- Description of HA_part phase --------------------------------------------------
Ca                       @Ca.HA_part()            
H                        @H.HA_part()             
O                        @O.HA_part()             

---------------------------- Description of HFO_part phase --------------------------------------------------
Ca                       @Ca.HFO_part()           
H                        @H.HFO_part()            
O                        @O.HFO_part()            

---------------------------- Description of HFO_part_l phase --------------------------------------------------
Ca                       @Ca.HFO_part_l()         
H                        @H.HFO_part_l()          
O                        @O.HFO_part_l()          

---------------------------- Description of SFA_part_l phase --------------------------------------------------
Ca                       @Ca.SFA_part_l()         
H                        @H.SFA_part_l()          
O                        @O.SFA_part_l()          

---------------------------- Description of SHA_part_l phase --------------------------------------------------
Ca                       @Ca.SHA_part_l()         
H                        @H.SHA_part_l()          
O                        @O.SHA_part_l()          

---------------------------- Description of ads phase --------------------------------------------------
Ca                       @Ca.ads()                
H                        @H.ads()                 
O                        @O.ads()                 

---------------------------- Description of colloid phase --------------------------------------------------
Ca                       @Ca.colloid()            
H                        @H.colloid()             
O                        @O.colloid()             

---------------------------- Description of gas phase --------------------------------------------------
Ca                       @Ca.gas()                
H                        @H.gas()                 
O                        @O.gas()                 

---------------------------- Description of gas_l phase --------------------------------------------------
Ca                       @Ca.gas_l()              
H                        @H.gas_l()               
O                        @O.gas_l()               

---------------------------- Description of kg phase --------------------------------------------------
Ca                       @Ca.kg()                 
H                        @H.kg()                  
O                        @O.kg()                  

---------------------------- Description of liter phase --------------------------------------------------
Ca                       @Ca.liter()              
H                        @H.liter()               
O                        @O.liter()               
    H2O                        @H2O.con()  @H2O.logact()@evaluate:("10^@H2O.logact()") 

---------------------------- Description of solid phase --------------------------------------------------
Ca                       @Ca.solid()              
H                        @H.solid()               
O                        @O.solid()               

---------------------------- Description of solution phase --------------------------------------------------
Ca                       @Ca.solution()           
H                        @H.solution()            
O                        @O.solution()            

---------------------------- Description of temporary phase --------------------------------------------------
Ca                       @Ca.temporary()          
H                        @H.temporary()           
O                        @O.temporary()           

---------------------------- Description of tot phase --------------------------------------------------
Ca                       @Ca.tot()                
H                        @H.tot()                 
    H[+1]                      @H[+1].con()  @H[+1].logact()@evaluate:("10^@H[+1].logact()") 
O                        @O.tot()                 
    O[-2]                      @O[-2].con()  @O[-2].logact()@evaluate:("10^@O[-2].logact()") 
}
@class: outputline(){Var: Node_ID T pH pe I H2O.logact tot_nr_iter Ca.diss Ca+2.con Ca+2.logact Ca+2.logf Ca[OH]+.con Ca[OH]+.logact Ca[OH]+.logf H.diss Ca[OH]+.con Ca[OH]+.logact Ca[OH]+.logf H+.con H+.logact H+.logf OH-.con OH-.logact OH-.logf O.diss Ca[OH]+.con Ca[OH]+.logact Ca[OH]+.logf OH-.con OH-.logact OH-.logf Ca.min H.min O.min Ca.CLAY_part H.CLAY_part O.CLAY_part Ca.CLAY_part_l H.CLAY_part_l O.CLAY_part_l Ca.DFA_part H.DFA_part O.DFA_part Ca.DHA_part H.DHA_part O.DHA_part Ca.FA_part H.FA_part O.FA_part Ca.Goethite_part H.Goethite_part O.Goethite_part Ca.Goethite_part_l H.Goethite_part_l O.Goethite_part_l Ca.HA_part H.HA_part O.HA_part Ca.HFO_part H.HFO_part O.HFO_part Ca.HFO_part_l H.HFO_part_l O.HFO_part_l Ca.SFA_part_l H.SFA_part_l O.SFA_part_l Ca.SHA_part_l H.SHA_part_l O.SHA_part_l Ca.ads H.ads O.ads Ca.colloid H.colloid O.colloid Ca.gas H.gas O.gas Ca.gas_l H.gas_l O.gas_l Ca.kg H.kg O.kg Ca.liter H.liter O.liter H2O.con H2O.logact Ca.solid H.solid O.solid Ca.solution H.solution O.solution Ca.temporary H.temporary O.temporary Ca.tot H.tot H[+1].con H[+1].logact O.tot O[-2].con O[-2].logact }
