     N[-3]                     @N[-3].con()  @N[-3].logact()@evaluate:("10^@N[-3].logact()") 
 SO4-2                    @SO4-2.tot()            
     S                         @S.con()  @S.logact()@evaluate:("10^@S.logact()") 
     S[+6]                     @S[+6].con()  @S[+6].logact()@evaluate:("10^@S[+6].logact()") 
     S[-2]                     @S[-2].con()  @S[-2].logact()@evaluate:("10^@S[-2].logact()") 

