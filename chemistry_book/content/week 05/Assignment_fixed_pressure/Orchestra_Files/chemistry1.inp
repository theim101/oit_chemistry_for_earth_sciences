//********* Adsorption Model HA *******************

@donnanmodel(HA, Waste_part, 1, "10^(-0.49*log10(I)- -0.49-1)")
//**** Model specific text **** 
@class: adsorptionmodeltext(HA){
//----------------------------------------------------------------------------------------
// The NICA-Donnan model with set of parameters for humic (HA) and fulvic (FA) acid.
// This model is composed of a Donnan model and 2 Nica sites.
// In this case the volume of the Donnan layer is not fixed but calculated according 
// to the literal expression given.
// (Milne, ES&T 37, 958-971, 2003)
//----------------------------------------------------------------------------------------
}
//**** End of model specific text **** 


//** Automatically generated donnan species for HA
@donnanspecies(Acetate-_HA_don, HA_don, Acetate-, -1)
@donnanspecies(CO3-2_HA_don, HA_don, CO3-2, -2)
