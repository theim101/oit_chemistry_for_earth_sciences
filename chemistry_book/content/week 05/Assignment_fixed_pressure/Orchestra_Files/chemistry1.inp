@phase(solid)
@link_phase(solid, liter, "1")
@phase(min)
@link_phase(min, solid, "1")
@phase(ads)
@link_phase(ads, solid, "1")
@phase(Waste_part_l)
@link_phase(Waste_part_l, ads, "1")
@phase(Waste_part)
@link_phase(Waste_part, Waste_part_l, "Waste_kgkg*SL")
@phase(CLAY_part_l)
