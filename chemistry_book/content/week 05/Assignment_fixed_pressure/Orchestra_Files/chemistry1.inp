//********* add @userfriendlyformat: to get output of reactions in user friendly format *******
@class: PHREEQCOutput(){
----------------------------Description of solution--------------------------------------------------
                            Cellnumber = @Node_ID()
                                    pH = @pH()
                                    pe = @pe()
                    Activity of water  = @evaluate:("10^@H2O.logact()")
                       Ionic strength  = @I()
           Total number of iterations  = @tot_nr_iter()

----------------------------Distribution of aqueous species---------------------------------------------

     Species            concentration (Mol/l)        Log Activity              Activity             log gamma   
 Acetate-            @Acetate-.diss()   
     Acetate-             @Acetate-.con()  @Acetate-.logact()@evaluate:("10^@Acetate-.logact()")    @evaluate:("-@Acetate-.logf()")
     Ca[Acetate]+         @Ca[Acetate]+.con()  @Ca[Acetate]+.logact()@evaluate:("10^@Ca[Acetate]+.logact()")    @evaluate:("-@Ca[Acetate]+.logf()") 
     H[Acetate]           @H[Acetate].con()  @H[Acetate].logact()@evaluate:("10^@H[Acetate].logact()")    @evaluate:("-@H[Acetate].logf()") 
 Ca+2                @Ca+2.diss()       
     Ca+2                 @Ca+2.con()  @Ca+2.logact()@evaluate:("10^@Ca+2.logact()")    @evaluate:("-@Ca+2.logf()")
     CaCO3                @CaCO3.con()  @CaCO3.logact()@evaluate:("10^@CaCO3.logact()")    @evaluate:("-@CaCO3.logf()") 
     CaHCO3+              @CaHCO3+.con()  @CaHCO3+.logact()@evaluate:("10^@CaHCO3+.logact()")    @evaluate:("-@CaHCO3+.logf()") 
     CaNH3+2              @CaNH3+2.con()  @CaNH3+2.logact()@evaluate:("10^@CaNH3+2.logact()")    @evaluate:("-@CaNH3+2.logf()") 
     CaOH+                @CaOH+.con()  @CaOH+.logact()@evaluate:("10^@CaOH+.logact()")    @evaluate:("-@CaOH+.logf()") 
     CaSO4                @CaSO4.con()  @CaSO4.logact()@evaluate:("10^@CaSO4.logact()")    @evaluate:("-@CaSO4.logf()") 
     Ca[Acetate]+         @Ca[Acetate]+.con()  @Ca[Acetate]+.logact()@evaluate:("10^@Ca[Acetate]+.logact()")    @evaluate:("-@Ca[Acetate]+.logf()") 
     Ca[NH3]2+2           @Ca[NH3]2+2.con()  @Ca[NH3]2+2.logact()@evaluate:("10^@Ca[NH3]2+2.logact()")    @evaluate:("-@Ca[NH3]2+2.logf()") 
 H                   @H.diss()          
     CO3-2                @CO3-2.con()  @CO3-2.logact()@evaluate:("10^@CO3-2.logact()")    @evaluate:("-@CO3-2.logf()") 
     CaCO3                @CaCO3.con()  @CaCO3.logact()@evaluate:("10^@CaCO3.logact()")    @evaluate:("-@CaCO3.logf()") 
     CaNH3+2              @CaNH3+2.con()  @CaNH3+2.logact()@evaluate:("10^@CaNH3+2.logact()")    @evaluate:("-@CaNH3+2.logf()") 
     CaOH+                @CaOH+.con()  @CaOH+.logact()@evaluate:("10^@CaOH+.logact()")    @evaluate:("-@CaOH+.logf()") 
