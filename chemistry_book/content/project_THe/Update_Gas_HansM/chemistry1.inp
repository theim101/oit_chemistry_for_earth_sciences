@NrDigits: 12  // number of decimal places in reaction coefficients. 
 //@rewriteReactions:   //indicates that reactions are rewritten in terms of primary entities. 
 //@include_molar_volume_parameters:   //include molar volume parameters from phreeqc database in species definitions. 

//********* The database file(s) *******
// This section lists the database files that are used by the interactive chemistry editor
// The database file is not used during the calculations!
// Syntax for local files:                   @database: minteq.txt
// Syntax for files on the internet:         @database: www.meeussen.nl/orchestra/minteqv4.txt

@database: PHREEQC_SIT_e-_ThermoChimie_v12a.dat
//********* End of the database file(s) *******


//********* Extra text 0 *******

@class: extra_text_0(){
 // Space for extra code that will be used in the calculations but will not be changed by the GUI. 
@scan: objects2025.txt
}
@extra_text_0()
//********* End of extra text 0 *******


//********* The variables *******
@Var: <name>.eq 0 // equation that has to become 0 during iteration
@Var: <name>.si 0 // log saturation index
@Var: <name>.si2 0 // si divided by sum of stoichimethy of reactants in formation reaction.
@Var: <name>.un -1e-3 // the unknown that is varied until equation becomes 0
@Var: CLAY_kgkg 0.0 // 
@Var: DFA_kgl 0.0 // 
@Var: DHA_kgl 0.0 // 
@Var: E.logact 1 // 
@Var: Goethite_kgkg 0.0 // 
@Var: H+.logact 1.0 // 
@Var: H.logact 1 // 
@GlobalVar: H2O.logact 0.0 // 
@Var: HFO_kgkg 0.0 // 
@GlobalVar: I .1 // 
@Var: O.logact 1 // 
@Var: SFA_kgkg 0.0 // 
@Var: SHA_kgkg 0.0 // 
@Var: SL 1.0 // 
@GlobalVar: T 298.15 // 
@Var: density 1.0 // 
@Var: e-.act 1.0 // 
@Var: e-.logact 1.0 // 
@Var: gasvolume 1 // 
@Var: hfo 0.0 // 
@Var: kglhfo 1.0E-4 // 
@Var: log_p[O2] 0.0 // 
@Var: minTol 1.0E-4 // 
@Var: pH 9.0 // 
@Var: pe 7.0 // 
@Var: porosity 1.0 // 
@Var: saturation 1 // 
@Var: totvolume 1 // 
@Var: watervolume 1.0 // 
//********* End of the variables *******


//********* Extra text 1 *******
@class: extra_text_1(){}
@extra_text_1()
//********* End of extra text 1 *******

//********* The phases *******
@phase(tot)
@phase(gas)
@link_phase(gas, tot, "gasvolume/molargasvolume")
