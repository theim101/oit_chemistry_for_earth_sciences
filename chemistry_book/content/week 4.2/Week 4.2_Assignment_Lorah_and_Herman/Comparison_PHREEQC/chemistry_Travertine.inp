    Mg                         @Mg.con()  @Mg.logact()@evaluate:("10^@Mg.logact()") 
Na+                      @Na+.tot()               
    Na                         @Na.con()  @Na.logact()@evaluate:("10^@Na.logact()") 
SO4-2                    @SO4-2.tot()             
    S                          @S.con()  @S.logact()@evaluate:("10^@S.logact()") 
    S[+6]                      @S[+6].con()  @S[+6].logact()@evaluate:("10^@S[+6].logact()") 
}
