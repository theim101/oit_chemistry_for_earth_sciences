//********* The primary entities *******
@balance_charge(pH)
@gas(Ar[g])
@primary_entity(Ar[g], -9.0)
@species(CO3-2, -2)
@primary_entity(CO3-2, -9.0, tot, 0.01)
@species(Ca+2, 2)
@primary_entity(Ca+2, -9.0, tot, 0.01)
@species(F-, -1)
@primary_entity(F-, -9.0, tot, 5.0)
@Global: pH
@Calc:(1, "H+.logact = -pH")
@species(H+, 1)
@primary_entity(H+, pH, 7.0)
@entity(H2O, liter, 55.6)
@primary_entity(H2O, 0.0)
@species(Mn+2, 2)
@primary_entity(Mn+2, -9.0, tot, 0.01)
@species(Na+, 1)
@primary_entity(Na+, -9.0, tot, 0.01)
@species(SO4-2, -2)
@primary_entity(SO4-2, -9.0, tot, 5.0)
