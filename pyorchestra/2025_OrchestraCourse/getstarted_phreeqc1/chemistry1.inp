//********* Extra text 0 *******

@class: extra_text_0(){
@scan: objects2024.txt

// This demo shows how to: 
// - define variables
// - define expressions
// - define equations to solve
// - define templates (or objects/classes/macros) with a name and set of parameters

@class: solve_equation(y_value){
   // just an example how to solve arbitrary  equations in ORCHESTRA
   // Define 2 variables

   @Var: x .2
   @Var: y  <y_value>

   //Define equation to calculate y from x
   @Calc: (1, "y = (x^2-pH)")

   //Find x for given value of y
   @solve: unknown:(name:, x) equation:(name:, y)
}


@solve_equation(10)
}
@extra_text_0()
