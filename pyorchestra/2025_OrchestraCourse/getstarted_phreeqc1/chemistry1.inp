@PHREEQC_Output:
@class: PHREEQCOutput(){
----------------------------Description of solution--------------------------------------------------
                            Cellnumber = @Node_ID()
                                    pH = @pH()
                                    pe = @pe()
                    Activity of water  = @evaluate:("10^@H2O.logact()")
                       Ionic strength  = @I()
           Total number of iterations  = @tot_nr_iter()

----------------------------Distribution of aqueous species---------------------------------------------

     Species            concentration (Mol/l)        Log Activity              Activity             log gamma   
 Al                  @Al.diss()         
     Al+3                 @Al+3.con()  @Al+3.logact()@evaluate:("10^@Al+3.logact()")    @evaluate:("-@Al+3.logf()") 
     AlF+2                @AlF+2.con()  @AlF+2.logact()@evaluate:("10^@AlF+2.logact()")    @evaluate:("-@AlF+2.logf()") 
     AlF2+                @AlF2+.con()  @AlF2+.logact()@evaluate:("10^@AlF2+.logact()")    @evaluate:("-@AlF2+.logf()") 
     AlF3                 @AlF3.con()  @AlF3.logact()@evaluate:("10^@AlF3.logact()")    @evaluate:("-@AlF3.logf()") 
     AlF4-                @AlF4-.con()  @AlF4-.logact()@evaluate:("10^@AlF4-.logact()")    @evaluate:("-@AlF4-.logf()") 
     AlOH+2               @AlOH+2.con()  @AlOH+2.logact()@evaluate:("10^@AlOH+2.logact()")    @evaluate:("-@AlOH+2.logf()") 
     Al[OH]2+             @Al[OH]2+.con()  @Al[OH]2+.logact()@evaluate:("10^@Al[OH]2+.logact()")    @evaluate:("-@Al[OH]2+.logf()") 
     Al[OH]3              @Al[OH]3.con()  @Al[OH]3.logact()@evaluate:("10^@Al[OH]3.logact()")    @evaluate:("-@Al[OH]3.logf()") 
     Al[OH]4-             @Al[OH]4-.con()  @Al[OH]4-.logact()@evaluate:("10^@Al[OH]4-.logact()")    @evaluate:("-@Al[OH]4-.logf()") 
 CO2[g]              @CO2[g].diss()     
     CH4                  @CH4.con()  @CH4.logact()@evaluate:("10^@CH4.logact()")    @evaluate:("-@CH4.logf()") 
     CO2                  @CO2.con()  @CO2.logact()@evaluate:("10^@CO2.logact()")    @evaluate:("-@CO2.logf()") 
     CO3-2                @CO3-2.con()  @CO3-2.logact()@evaluate:("10^@CO3-2.logact()")    @evaluate:("-@CO3-2.logf()") 
